{
    "name": "vue-simple-arc",
    "version": "0.3.0",
    "description": "Lightweight Vue 3 gauge: SVG half arc and circular progress ring. Animated, responsive, accessible, SSR-ready, TypeScript, zero dependencies (~1.6 kB gzip).",
    "keywords": [
        "vue",
        "vue3",
        "vue-component",
        "gauge",
        "arc",
        "progress",
        "progress-ring",
        "animated",
        "circular-progress",
        "radial-progress",
        "progress-circle",
        "circle",
        "donut",
        "dashboard",
        "kpi",
        "svg",
        "ssr",
        "nuxt",
        "accessible",
        "a11y",
        "typescript",
        "lightweight",
        "zero-dependency"
    ],
    "author": "Luyny",
    "license": "MIT",
    "homepage": "https://github.com/Luyny/vue-simple-arc#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Luyny/vue-simple-arc.git"
    },
    "bugs": {
        "url": "https://github.com/Luyny/vue-simple-arc/issues"
    },
    "type": "module",
    "main": "./dist/vue-simple-arc.cjs",
    "module": "./dist/vue-simple-arc.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/vue-simple-arc.js",
            "require": "./dist/vue-simple-arc.cjs"
        }
    },
    "files": [
        "dist"
    ],
    "sideEffects": false,
    "scripts": {
        "build": "vite build",
        "test": "vitest run",
        "prepack": "npm run build",
        "prepublishOnly": "npm test"
    },
    "peerDependencies": {
        "vue": "^3.3.0"
    },
    "devDependencies": {
        "@vitejs/plugin-vue": "^6.0.9",
        "@vue/language-core": "^3.3.11",
        "@vue/test-utils": "^2.5.1",
        "jsdom": "^30.1.1",
        "typescript": "~5.9.3",
        "vite": "^8.3.1",
        "vite-plugin-dts": "^5.1.1",
        "vitest": "^5.0.3",
        "vue": "^3.5.43"
    }
}
