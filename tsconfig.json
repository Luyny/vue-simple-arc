{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "jsx": "preserve",
        "skipLibCheck": true,
        "isolatedModules": true,
        "declaration": true,
        "noEmit": true
    },
    "include": ["src/**/*.ts", "src/**/*.vue"]
}
